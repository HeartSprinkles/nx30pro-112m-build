#
# H3C Magic NX30 Pro 112M —— 增量配置
#
# 基准：源码自带的 defconfig/mt7981-ax3000.config（保留其全部软件包 / 工具链 /
# DEVEL / MULTI_PROFILE 等设置），本文件只叠加模板里没有、而我们必须有的东西。
#
# 注意：WiFi 不在这里配置。模板选中的 92 个设备里只有 NX30 Pro 的 DEVICE_PACKAGES
# 是空的，所以 WiFi 三件套由 device/h3c_magic-nx30-pro-112m.mk 带入。
#

# 根文件系统大小（模板未设置；保持 104M，确保镜像不超过 IMAGE_SIZE = 112M）
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# --- LuCI ------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# Glass 主题（Apple 风毛玻璃），由 files/ 里的 uci-defaults 设为默认主题
CONFIG_PACKAGE_luci-theme-glass=y

# --- nikki（mihomo 透明代理）-----------------------------------------
# luci-app-nikki -> nikki -> mihomo（由 mihomo-meta 从 Go 源码编译）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# nikki 运行时依赖（显式列出，避免 feed 依赖变动后静默丢失）
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y

# --- 编译加速 --------------------------------------------------------
CONFIG_CCACHE=y

# --- 小工具 ----------------------------------------------------------
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y
