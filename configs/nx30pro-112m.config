#
# ImmortalWrt 25.12 (immortalwrt-mt798x-rebase) - H3C Magic NX30 Pro 112M
#
# This is a "seed" config: it only contains the options we care about.
# `make defconfig` fills in everything else (dependencies, defaults).
# Do NOT paste a full .config from another source branch here.
#

# --- Target / device -------------------------------------------------
CONFIG_TARGET_mediatek=y
CONFIG_TARGET_mediatek_filogic=y
# 25.12 的符号名是 CONFIG_TARGET_<target>_DEVICE_<dev>，
# 旧版的 CONFIG_TARGET_DEVICE_<target>_DEVICE_<dev> 已不再使用
CONFIG_TARGET_mediatek_filogic_DEVICE_h3c_magic-nx30-pro-112m=y

# Rootfs / overlay size hint (the real limit is IMAGE_SIZE = 114688k)
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# Reuse the compiler cache on the runner (speeds up re-runs a lot)
CONFIG_CCACHE=y

# 内核调试符号对家用路由器毫无价值，关掉能明显缩短内核编译时间、减小镜像
# CONFIG_KERNEL_DEBUG_INFO is not set
# CONFIG_KERNEL_DEBUG_INFO_BTF is not set

# --- LuCI ------------------------------------------------------------
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y

# Glass theme (Apple-style glassmorphism), becomes the default theme
CONFIG_PACKAGE_luci-theme-glass=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# --- nikki (mihomo transparent proxy) --------------------------------
# luci-app-nikki -> nikki -> mihomo (provided by mihomo-meta, built from Go)
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# nikki runtime dependencies (listed explicitly so a dependency typo in the
# feed cannot silently drop them)
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y

# --- QoL -------------------------------------------------------------
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_luci-app-ttyd=y
