#
# H3C Magic NX30 Pro 112M —— 增量配置
#
# 基准：源码自带的 defconfig/mt7981-ax3000.config
#       （保留其全部软件包 / 工具链 / DEVEL / 闭源 WiFi 设置）
#
# 本文件只写"模板里没有、而我们必须有"的项。模板已有的不要重复写：
#   luci / htop / kmod-tun / kmod-inet-diag / kmod-nft-socket / kmod-nft-tproxy
#   kmod-mt_wifi / mtwifi-cfg-ucode / luci-app-mtwifi-cfg / CONFIG_MTK_CHIP_MT7981
#

# 根文件系统大小（模板未设置；保持 104M，确保镜像不超过 IMAGE_SIZE = 112M）
CONFIG_TARGET_ROOTFS_PARTSIZE=104

# --- LuCI ------------------------------------------------------------
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y


# --- nikki（mihomo 透明代理）-----------------------------------------
# luci-app-nikki -> nikki -> mihomo（由 mihomo-meta 从 Go 源码编译）
CONFIG_PACKAGE_luci-app-nikki=y
CONFIG_PACKAGE_luci-i18n-nikki-zh-cn=y

# nikki 依赖中模板没有的几个（其余 kmod 模板已含）
CONFIG_PACKAGE_kmod-dummy=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_yq=y

# --- 编译加速 --------------------------------------------------------
CONFIG_CCACHE=y

# --- 小工具 ----------------------------------------------------------
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_luci-app-package-manager=y
